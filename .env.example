# Leave blank when the frontend and FastAPI API share one domain.
VITE_BACKEND_URL=https://your-supporter-backend.onrender.com

# Existing supporter backend API prefix + the new audio route.
VITE_AUDIO_API_PATH=/api/audio

# Check for a changed Telegram audio version every 15 seconds.
VITE_AUDIO_POLL_MS=15000
VITE_AUDIO_REQUEST_TIMEOUT_MS=30000
